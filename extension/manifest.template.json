{
  "manifest_version": 3,
  "name": "Next Ep. Lock",
  "version": "0.1.0",
  "description": "Locks reanime.to until you've applied to enough jobs. Phase 2 MVP — reanime.to only.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://reanime.to/*",
    "https://flixcloud.cc/*",
    "{{WEB_APP_ORIGIN}}/*",
    "https://api.animechan.io/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://reanime.to/*"],
      "js": ["content/lock-overlay.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://flixcloud.cc/*"],
      "all_frames": true,
      "js": ["content/flixcloud-detect.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html"
}
