# Copy to .env.local (gitignored) and fill in.
# Supabase project settings -> API. The anon key is safe to expose: every
# anime_jobs table has RLS enabled, so it only ever returns the caller's rows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Phase 1 runs single-user with no login UI, but RLS still requires a real
# session (auth.uid() must not be null). Create one user in Supabase
# Auth -> Users and put its credentials here; the server signs in as that
# user to make its queries. Phase 5 replaces this with real auth.
#
# Never put the service_role key in this file or anywhere in this repo.
ANIME_JOBS_USER_EMAIL=you@example.com
ANIME_JOBS_USER_PASSWORD=the-password-you-set

# Phase 2: the browser extension authenticates to /api/* with this as a
# bearer token (Authorization: Bearer <value>) instead of a real Supabase
# session — see web/lib/extension-auth.ts. Generate any long random string,
# e.g. `openssl rand -hex 32`. The /settings page displays this value so it
# can be copied into the extension's options page. Phase 5 replaces this with
# real per-user auth.
EXTENSION_API_TOKEN=generate-a-long-random-string

# Phase 3: the scraper. Adzuna is the one source that needs credentials —
# free at https://developer.adzuna.com/ . Leave both blank to skip that board
# (the run is logged as "skipped", nothing breaks).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Protects GET /api/cron/scrape. Vercel Cron sends it automatically as
# `Authorization: Bearer <CRON_SECRET>` when this env var is set on the
# project; locally, pass the same header by hand. Any long random string.
CRON_SECRET=generate-another-long-random-string
